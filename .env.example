# Credentials for ONE QuickBooks company. This server talks to a single realm;
# deploy it once per company.
#
# Obtain these from developer.intuit.com -> your app -> Keys & credentials.
# Which Intuit app, and how you authorize it, is entirely your decision -- this
# server never runs the authorization step, it only reads the resulting token.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=

# Where the refresh token lives. Defaults to ~/.quickbooks-online/tokens.json.
# Seed it with the SDK's scripts/get_refresh_token.py.
#
# Intuit rotates this token on every refresh and invalidates the previous one,
# so this file is the only live copy of the credential. In a container it must
# point at a mounted volume.
# QBO_TOKEN_STORE=/data/qbo-tokens.json

# Writes are refused entirely while this is true, before any request is sent.
# This is a live general ledger. Start true.
QBO_READ_ONLY=true

# minorversion pins which fields the API returns. The SDK's default tracks
# Intuit's documented default.
# QBO_MINOR_VERSION=75

# Rows returned before a response is summarised rather than listed in full.
# QBO_MAX_ROWS=50
