# Credentials for ONE QuickBooks company. This server talks to a single realm;
# deploy it once per company.
#
# Obtain these from developer.intuit.com -> your app -> Keys & credentials.
# Which Intuit app, and how you authorize it, is entirely your decision -- this
# server never runs the authorization step, it only reads the resulting token.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=

# Where the refresh token lives. Defaults to ~/.quickbooks-online/tokens.json.
# Seed it with the SDK's scripts/get_refresh_token.py.
#
# Intuit rotates this token on every refresh and invalidates the previous one,
# so this file is the only live copy of the credential. In a container it must
# point at a mounted volume.
# QBO_TOKEN_STORE=/data/qbo-tokens.json

# Writes are refused entirely while this is true, before any request is sent.
# This is a live general ledger. Start true.
QBO_READ_ONLY=true

# minorversion pins which fields the API returns. The SDK's default tracks
# Intuit's documented default.
# QBO_MINOR_VERSION=75

# Rows returned before a response is summarised rather than listed in full.
# QBO_MAX_ROWS=50

# --- Who may connect -------------------------------------------------------
#
# MCP_AUTH=none is right for stdio, where reaching the process means already
# holding the machine. Anything reachable over a network needs one of the
# others.
#
#   none   no authentication
#   jwt    verify bearer tokens against a JWKS endpoint
#   oidc   full OAuth against any OpenID Connect provider
#
# MCP_AUTH=none
#
# For oidc:
# MCP_BASE_URL=https://books.example.com
# MCP_OIDC_CONFIG_URL=https://.../.well-known/openid-configuration
# MCP_OIDC_CLIENT_ID=
# MCP_OIDC_CLIENT_SECRET=
# MCP_JWT_SIGNING_KEY=
#
# Signing in is not the same as being allowed in.
#
# An organisational provider answers both at once: if someone is assigned to
# the app, they are permitted. A consumer provider does not. Anyone with an
# Intuit account can complete a Sign in with Intuit flow, and Intuit exposes no
# way to ask whether they have any connection to the company this server reads
# -- its own single sign-on documentation says the app maps Intuit identities
# to its own users.
#
# So with Intuit this list is not optional. Key it on the subject identifier,
# not an email: emails change hands and can be unverified, while a subject is
# opaque, stable and issued by the provider. Find a user's subject in the
# `sub` claim of their ID token.
# MCP_OIDC_ALLOWED_SUBJECTS=1182d6ec-2a1f-4aa3-af3f-bb3b95db45af,...
#
# Emails work too, and are checked for the provider's verified flag because an
# unverified address may belong to somebody else.
# MCP_OIDC_ALLOWED_EMAILS=

# To sign in with QuickBooks credentials:
# MCP_AUTH=oidc
# MCP_OIDC_CONFIG_URL=https://developer.api.intuit.com/.well-known/openid_configuration
# MCP_OIDC_SCOPES=openid,email,profile
#
# Request only those scopes. Adding the accounting scope would make each
# sign-in a fresh company authorization, and Intuit disconnects the previous
# one when that happens -- every user signing in would break this server's own
# connection to the ledger.
